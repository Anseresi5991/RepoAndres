//@version=5
indicator("13 Combos EMA Touch", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════
// PARÁMETROS COMPARTIDOS
// ═══════════════════════════════════════════════════════════════
grp_shared         = "Parámetros Compartidos EMA Touch"
slow_ema_per       = input.int(200,  "Período EMA Lenta",        minval=2,   group=grp_shared, tooltip="EMA lenta para filtro de tendencia")
use_slow_filter    = input.bool(true,"Filtro EMA Lenta activo",  group=grp_shared, tooltip="Si activo: SHORT requiere EMA combo < EMA lenta. LONG requiere EMA combo > EMA lenta")
ema_slope_lb       = input.int(5,    "Pendiente EMA (velas)",    minval=1,   group=grp_shared, tooltip="Velas atrás para medir pendiente de la EMA de cada combo")
use_slope_filter   = input.bool(true,"Filtro pendiente activo",  group=grp_shared, tooltip="Si activo: SHORT requiere EMA bajando, LONG requiere EMA subiendo")
max_body_pct       = input.float(50.0,"Cuerpo máx. vela (%)",   minval=0.0, step=1.0,  group=grp_shared, tooltip="0 = sin filtro. % máx del cuerpo en la vela señal")
consistency_bars   = input.int(3,    "Velas consistencia EMA",  minval=1,   group=grp_shared, tooltip="Mínimo de velas con cuerpo del mismo lado antes de cruzar la EMA")
min_cross_body_pct = input.float(30.0,"Cuerpo cruce mín. (%)",  minval=0.0, step=1.0,  group=grp_shared, tooltip="0 = sin filtro. % mín del cuerpo en la vela que cruza la EMA")
direction_input    = input.string("BOTH","Dirección",            options=["BOTH","SHORT","LONG"], group=grp_shared, tooltip="BOTH: SHORT tiene prioridad sobre LONG dentro de cada combo")

