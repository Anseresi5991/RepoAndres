ema4      = ta.ema(close, ema_per4)
prev_ema4 = ema4[ema_slope_lb]
bear4     = not use_slow_filter or ema4 < slow_ema_val
bull4     = not use_slow_filter or ema4 > slow_ema_val
sdn4      = not use_slope_filter or ema4 < prev_ema4
sup4_s    = not use_slope_filter or ema4 > prev_ema4
cs4       = high >= ema4 and max_oc < ema4 and bear4 and sdn4 and body_ok and close < open
