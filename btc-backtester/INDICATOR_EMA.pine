    bac3 := 0
ft_sh3 = cs3 and ctb3 and cbs3 and not fsd3 and upper_wick_pct >= min_wick3
if ft_sh3
    fsd3 := true

var int  bbc3 = 0
var bool cta3 = false
var bool fld3 = false
var bool cbl3 = false
if min_oc <= ema3
    bbc3 := bbc3+1
    cta3 := false
    fld3 := false
    cbl3 := false
else
    if bbc3 >= consistency_bars
        cta3 := true
        cbl3 := min_cross_body_pct<=0 or (close>open and candle_range>0 and (close-open)/candle_range*100>=min_cross_body_pct)
    bbc3 := 0
ft_lo3 = cl3 and cta3 and cbl3 and not fld3 and lower_wick_pct >= min_wick3
if ft_lo3
    fld3 := true

sig_s3 = use_c3 and direction_input != "LONG"  and ft_sh3
sig_l3 = use_c3 and direction_input != "SHORT" and ft_lo3 and not sig_s3
