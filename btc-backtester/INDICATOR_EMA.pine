fee_tp_pct      = input.float(0.05,   "Fee descontado TP (%)",minval=0.0, step=0.01,  group=grp_stats)
leverage        = input.float(10.0,   "Apalancamiento",       minval=1.0, step=1.0,   group=grp_stats)
