var bool cbs4 = false
if max_oc >= ema4
    bac4 := bac4+1
    ctb4 := false
    fsd4 := false
    cbs4 := false
else
    if bac4 >= consistency_bars
        ctb4 := true
        cbs4 := min_cross_body_pct<=0 or (open>close and candle_range>0 and (open-close)/candle_range*100>=min_cross_body_pct)
    bac4 := 0
ft_sh4 = cs4 and ctb4 and cbs4 and not fsd4 and upper_wick_pct >= min_wick4
if ft_sh4
    fsd4 := true

var int  bbc4 = 0
var bool cta4 = false
var bool fld4 = false
var bool cbl4 = false
if min_oc <= ema4
    bbc4 := bbc4+1
    cta4 := false
