account_5  = input.string("EMA_TOUCH_5",  "Account 5 combos",  group=grp_accounts)
account_4  = input.string("EMA_TOUCH_4",  "Account 4 combos",  group=grp_accounts)
account_3  = input.string("EMA_TOUCH_3",  "Account 3 combos",  group=grp_accounts)
account_2  = input.string("EMA_TOUCH_2",  "Account 2 combos",  group=grp_accounts)
account_1  = input.string("EMA_TOUCH_1",  "Account 1 combo",   group=grp_accounts)

// ═══════════════════════════════════════════════════════════════
// CÁLCULOS COMPARTIDOS
// ═══════════════════════════════════════════════════════════════
candle_range   = high - low
max_oc         = math.max(open, close)
min_oc         = math.min(open, close)
upper_wick_pct = candle_range > 0 ? (high - max_oc)  / candle_range * 100 : 0.0
lower_wick_pct = candle_range > 0 ? (min_oc - low)   / candle_range * 100 : 0.0
body_ratio     = candle_range > 0 ? math.abs(close - open) / candle_range * 100 : 0.0
body_ok        = max_body_pct <= 0 or body_ratio < max_body_pct
slow_ema_val   = ta.ema(close, slow_ema_per)

// ═══════════════════════════════════════════════════════════════
// MÁQUINAS DE ESTADO — un bloque por combo
// Nomenclatura por combo N:
//   emaN        = EMA value
//   bac{N}      = body_above_count  (SHORT state)
//   ctb{N}      = crossed_to_below
//   fsd{N}      = first_short_done
//   cbs{N}      = cross_body_ok_short
//   bbc{N}      = body_below_count  (LONG state)
//   cta{N}      = crossed_to_above
//   fld{N}      = first_long_done
//   cbl{N}      = cross_body_ok_long
//   ft_sh{N}    = first_touch_short (raw, sin filtro daily)
//   ft_lo{N}    = first_touch_long  (raw)
//   sig_s{N}    = signal SHORT para combo N
//   sig_l{N}    = signal LONG  para combo N
//   fires{N}    = fires_N (any direction)
// ═══════════════════════════════════════════════════════════════

// ─── COMBO 1 ─────────────────────────────────────────────────
ema1      = ta.ema(close, ema_per1)
prev_ema1 = ema1[ema_slope_lb]
bear1     = not use_slow_filter or ema1 < slow_ema_val
bull1     = not use_slow_filter or ema1 > slow_ema_val
sdn1      = not use_slope_filter or ema1 < prev_ema1
sup1_s    = not use_slope_filter or ema1 > prev_ema1
cs1       = high >= ema1 and max_oc < ema1 and bear1 and sdn1 and body_ok and close < open
cl1       = low  <= ema1 and min_oc > ema1 and bull1 and sup1_s and body_ok and close > open

var int  bac1 = 0
var bool ctb1 = false
var bool fsd1 = false
var bool cbs1 = false
if max_oc >= ema1
    bac1 := bac1+1
    ctb1 := false
    fsd1 := false
    cbs1 := false
else
    if bac1 >= consistency_bars
        ctb1 := true
        cbs1 := min_cross_body_pct<=0 or (open>close and candle_range>0 and (open-close)/candle_range*100>=min_cross_body_pct)
    bac1 := 0
ft_sh1 = cs1 and ctb1 and cbs1 and not fsd1 and upper_wick_pct >= min_wick1
if ft_sh1
    fsd1 := true

var int  bbc1 = 0
var bool cta1 = false
var bool fld1 = false
var bool cbl1 = false
if min_oc <= ema1
    bbc1 := bbc1+1
    cta1 := false
    fld1 := false
    cbl1 := false
else
    if bbc1 >= consistency_bars
        cta1 := true
        cbl1 := min_cross_body_pct<=0 or (close>open and candle_range>0 and (close-open)/candle_range*100>=min_cross_body_pct)
    bbc1 := 0
ft_lo1 = cl1 and cta1 and cbl1 and not fld1 and lower_wick_pct >= min_wick1
if ft_lo1
    fld1 := true

sig_s1 = direction_input != "LONG"  and ft_sh1
sig_l1 = direction_input != "SHORT" and ft_lo1 and not sig_s1
fires1 = sig_s1 or sig_l1

// ─── COMBO 2 ─────────────────────────────────────────────────
ema2      = ta.ema(close, ema_per2)
prev_ema2 = ema2[ema_slope_lb]
bear2     = not use_slow_filter or ema2 < slow_ema_val
bull2     = not use_slow_filter or ema2 > slow_ema_val
sdn2      = not use_slope_filter or ema2 < prev_ema2
sup2_s    = not use_slope_filter or ema2 > prev_ema2
cs2       = high >= ema2 and max_oc < ema2 and bear2 and sdn2 and body_ok and close < open
cl2       = low  <= ema2 and min_oc > ema2 and bull2 and sup2_s and body_ok and close > open

var int  bac2 = 0
var bool ctb2 = false
var bool fsd2 = false
var bool cbs2 = false
if max_oc >= ema2
    bac2 := bac2+1
    ctb2 := false
    fsd2 := false
    cbs2 := false
else
    if bac2 >= consistency_bars
        ctb2 := true
        cbs2 := min_cross_body_pct<=0 or (open>close and candle_range>0 and (open-close)/candle_range*100>=min_cross_body_pct)
    bac2 := 0
ft_sh2 = cs2 and ctb2 and cbs2 and not fsd2 and upper_wick_pct >= min_wick2
if ft_sh2
    fsd2 := true

var int  bbc2 = 0
var bool cta2 = false
var bool fld2 = false
var bool cbl2 = false
if min_oc <= ema2
    bbc2 := bbc2+1
    cta2 := false
    fld2 := false
    cbl2 := false
else
    if bbc2 >= consistency_bars
        cta2 := true
        cbl2 := min_cross_body_pct<=0 or (close>open and candle_range>0 and (close-open)/candle_range*100>=min_cross_body_pct)
    bbc2 := 0
ft_lo2 = cl2 and cta2 and cbl2 and not fld2 and lower_wick_pct >= min_wick2
if ft_lo2
    fld2 := true

sig_s2 = use_c2 and direction_input != "LONG"  and ft_sh2
sig_l2 = use_c2 and direction_input != "SHORT" and ft_lo2 and not sig_s2
fires2 = sig_s2 or sig_l2

// ─── COMBO 3 ─────────────────────────────────────────────────
ema3      = ta.ema(close, ema_per3)
prev_ema3 = ema3[ema_slope_lb]
bear3     = not use_slow_filter or ema3 < slow_ema_val
bull3     = not use_slow_filter or ema3 > slow_ema_val
sdn3      = not use_slope_filter or ema3 < prev_ema3
sup3_s    = not use_slope_filter or ema3 > prev_ema3
cs3       = high >= ema3 and max_oc < ema3 and bear3 and sdn3 and body_ok and close < open
