plotshape(show_signal_marks and op_s5,  title="SHORT C5",  style=shape.labeldown, location=location.abovebar, color=color.new(color.fuchsia, 0),    textcolor=color.white, size=size.tiny, text="C5▼")
plotshape(show_signal_marks and op_s6,  title="SHORT C6",  style=shape.labeldown, location=location.abovebar, color=color.new(color.lime,    0),    textcolor=color.black, size=size.tiny, text="C6▼")
plotshape(show_signal_marks and op_s7,  title="SHORT C7",  style=shape.labeldown, location=location.abovebar, color=color.new(color.yellow,  0),    textcolor=color.black, size=size.tiny, text="C7▼")
plotshape(show_signal_marks and op_s8,  title="SHORT C8",  style=shape.labeldown, location=location.abovebar, color=color.new(color.aqua,    0),    textcolor=color.black, size=size.tiny, text="C8▼")
plotshape(show_signal_marks and op_s9,  title="SHORT C9",  style=shape.labeldown, location=location.abovebar, color=color.new(color.maroon,  0),    textcolor=color.white, size=size.tiny, text="C9▼")
plotshape(show_signal_marks and op_s10, title="SHORT C10", style=shape.labeldown, location=location.abovebar, color=color.new(color.silver,  0),    textcolor=color.black, size=size.tiny, text="C10▼")
plotshape(show_signal_marks and op_s11, title="SHORT C11", style=shape.labeldown, location=location.abovebar, color=color.new(color.navy,    0),    textcolor=color.white, size=size.tiny, text="C11▼")
plotshape(show_signal_marks and op_s12, title="SHORT C12", style=shape.labeldown, location=location.abovebar, color=color.new(color.olive,   0),    textcolor=color.white, size=size.tiny, text="C12▼")
plotshape(show_signal_marks and op_s13, title="SHORT C13", style=shape.labeldown, location=location.abovebar, color=color.new(color.gray,    0),    textcolor=color.white, size=size.tiny, text="C13▼")

// ── Señales LONG (flecha arriba, debajo de la barra) ─────────
plotshape(show_signal_marks and op_l1,  title="LONG C1",  style=shape.labelup, location=location.belowbar, color=color.orange,                   textcolor=color.white, size=size.tiny, text="C1▲")
plotshape(show_signal_marks and op_l2,  title="LONG C2",  style=shape.labelup, location=location.belowbar, color=color.new(color.purple,  0),    textcolor=color.white, size=size.tiny, text="C2▲")
plotshape(show_signal_marks and op_l3,  title="LONG C3",  style=shape.labelup, location=location.belowbar, color=color.new(color.teal,    0),    textcolor=color.white, size=size.tiny, text="C3▲")
plotshape(show_signal_marks and op_l4,  title="LONG C4",  style=shape.labelup, location=location.belowbar, color=color.new(color.blue,    0),    textcolor=color.white, size=size.tiny, text="C4▲")
plotshape(show_signal_marks and op_l5,  title="LONG C5",  style=shape.labelup, location=location.belowbar, color=color.new(color.fuchsia, 0),    textcolor=color.white, size=size.tiny, text="C5▲")
plotshape(show_signal_marks and op_l6,  title="LONG C6",  style=shape.labelup, location=location.belowbar, color=color.new(color.lime,    0),    textcolor=color.black, size=size.tiny, text="C6▲")
plotshape(show_signal_marks and op_l7,  title="LONG C7",  style=shape.labelup, location=location.belowbar, color=color.new(color.yellow,  0),    textcolor=color.black, size=size.tiny, text="C7▲")
plotshape(show_signal_marks and op_l8,  title="LONG C8",  style=shape.labelup, location=location.belowbar, color=color.new(color.aqua,    0),    textcolor=color.black, size=size.tiny, text="C8▲")
plotshape(show_signal_marks and op_l9,  title="LONG C9",  style=shape.labelup, location=location.belowbar, color=color.new(color.maroon,  0),    textcolor=color.white, size=size.tiny, text="C9▲")
plotshape(show_signal_marks and op_l10, title="LONG C10", style=shape.labelup, location=location.belowbar, color=color.new(color.silver,  0),    textcolor=color.black, size=size.tiny, text="C10▲")
plotshape(show_signal_marks and op_l11, title="LONG C11", style=shape.labelup, location=location.belowbar, color=color.new(color.navy,    0),    textcolor=color.white, size=size.tiny, text="C11▲")
plotshape(show_signal_marks and op_l12, title="LONG C12", style=shape.labelup, location=location.belowbar, color=color.new(color.olive,   0),    textcolor=color.white, size=size.tiny, text="C12▲")
plotshape(show_signal_marks and op_l13, title="LONG C13", style=shape.labelup, location=location.belowbar, color=color.new(color.gray,    0),    textcolor=color.white, size=size.tiny, text="C13▲")

// ── Líneas de trade activo ────────────────────────────────────
plot(show_trade_lines and not na(entry_price)       ? entry_price       : na, "Entrada",    color=color.yellow, linewidth=2, style=plot.style_linebr)
plot(show_trade_lines and not na(stop_loss_price)   ? stop_loss_price   : na, "Stop Loss",  color=color.red,    linewidth=2, style=plot.style_linebr)
plot(show_trade_lines and not na(take_profit_price) ? take_profit_price : na, "Take Profit",color=color.lime,   linewidth=2, style=plot.style_linebr)

plotshape(tp_hit, title="TP alcanzado", style=shape.labelup,   location=location.belowbar, color=color.lime, textcolor=color.black, size=size.small, text="TP")
plotshape(sl_hit, title="SL alcanzado", style=shape.labeldown, location=location.abovebar, color=color.red,  textcolor=color.white, size=size.small, text="SL")

// ═══════════════════════════════════════════════════════════════
// TABLAS
// ═══════════════════════════════════════════════════════════════
combos_active = 1 + (use_c2?1:0) + (use_c3?1:0) + (use_c4?1:0) + (use_c5?1:0) + (use_c6?1:0) + (use_c7?1:0) + (use_c8?1:0) + (use_c9?1:0) + (use_c10?1:0) + (use_c11?1:0) + (use_c12?1:0) + (use_c13?1:0)

var table info_panel  = table.new(position.bottom_right, 2, 11, bgcolor=color.new(color.black, 60))
var table stats_panel = table.new(position.top_center,   2, 11, bgcolor=color.new(color.black, 60))

if barstate.islast
    ema1_dist = ema1 > 0 ? (close - ema1) / ema1 * 100 : 0.0
    trend_str  = bear1 ? "BAJISTA 🔴" : "ALCISTA 🟢"
    trend_col  = bear1 ? color.red : color.green

    signal_text =
         final_signal_1  ? "C1 — señal 🟠" :
         final_signal_2  ? "C2 — señal 🟣" :
         final_signal_3  ? "C3 — señal 🔵" :
         final_signal_4  ? "C4 — señal 💙" :
         final_signal_5  ? "C5 — señal 🟤" :
         final_signal_6  ? "C6 — señal 🟢" :
         final_signal_7  ? "C7 — señal 🟡" :
         final_signal_8  ? "C8 — señal 💧" :
         final_signal_9  ? "C9 — señal 🟥" :
         final_signal_10 ? "C10 — señal ⚪" :
         final_signal_11 ? "C11 — señal 🌑" :
         final_signal_12 ? "C12 — señal 🫒" :
         final_signal_13 ? "C13 — señal ⚫" :
         "Sin señal"

    net_col = total_net_pct >= 0 ? color.green : color.red
    dd_col  = max_drawdown_pct > 0 ? color.orange : color.gray

    table.cell(info_panel, 0, 0,  "EMA C1 (per " + str.tostring(ema_per1) + ")", text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 0,  str.tostring(ema1, "#.##"),                    text_color=color.white, text_size=size.small)
    table.cell(info_panel, 0, 1,  "Distancia EMA C1",                            text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 1,  str.tostring(ema1_dist, "#.##") + "%",         text_color=color.white, text_size=size.small)
    table.cell(info_panel, 0, 2,  "Tendencia C1",                                text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 2,  trend_str,                                      text_color=color.white, bgcolor=trend_col, text_size=size.small)
    table.cell(info_panel, 0, 3,  "Mecha Superior",                              text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 3,  str.tostring(upper_wick_pct, "#.##") + "%",    text_color=color.white, text_size=size.small)
    table.cell(info_panel, 0, 4,  "Mecha Inferior",                              text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 4,  str.tostring(lower_wick_pct, "#.##") + "%",    text_color=color.white, text_size=size.small)
    table.cell(info_panel, 0, 5,  "Dirección",                                   text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 5,  direction_input,                                text_color=color.white, text_size=size.small)
    table.cell(info_panel, 0, 6,  "Combos activos",                              text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 6,  str.tostring(combos_active),                    text_color=color.white, text_size=size.small)
    table.cell(info_panel, 0, 7,  "Señal actual",                                text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 7,  signal_text,                                    text_color=color.white, text_size=size.small)
    table.cell(info_panel, 0, 8,  "Entrada",                                     text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 8,  na(entry_price) ? "-" : str.tostring(entry_price, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(info_panel, 0, 9,  "SL / TP",                                    text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 9,  (na(stop_loss_price) or na(take_profit_price)) ? "-" : str.tostring(stop_loss_price,"#.##") + " / " + str.tostring(take_profit_price,"#.##"), text_color=color.white, text_size=size.small)
    table.cell(info_panel, 0, 10, "Resultado",                                   text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 10, trade_result,                                   text_color=color.white, text_size=size.small)

    table.cell(stats_panel, 0, 0,  "TP cerrados",                               text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 0,  str.tostring(total_tp_count),                 text_color=color.white, bgcolor=color.new(color.green, 60), text_size=size.small)
    table.cell(stats_panel, 0, 1,  "SL cerrados",                               text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 1,  str.tostring(total_sl_count),                 text_color=color.white, bgcolor=color.new(color.red,   60), text_size=size.small)
    table.cell(stats_panel, 0, 2,  "Trades cerrados",                           text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 2,  str.tostring(total_closed_trades),            text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 0, 3,  "Ganancia acum. x" + str.tostring(leverage,"#"), text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 3,  str.tostring(total_profit_pct,"#.##") + "%", text_color=color.white, bgcolor=color.new(color.green, 70), text_size=size.small)
    table.cell(stats_panel, 0, 4,  "Pérdida acum. x" + str.tostring(leverage,"#"),  text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 4,  str.tostring(total_loss_pct,"#.##") + "%",   text_color=color.white, bgcolor=color.new(color.red,   70), text_size=size.small)
    table.cell(stats_panel, 0, 5,  "Neto x" + str.tostring(leverage,"#"),       text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 5,  str.tostring(total_net_pct,"#.##") + "%",    text_color=color.white, bgcolor=net_col, text_size=size.small)
    table.cell(stats_panel, 0, 6,  "Win Rate",                                  text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 6,  str.tostring(win_rate,"#.##") + "%",         text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 0, 7,  "Máx. caída",                                text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 7,  str.tostring(max_drawdown_pct,"#.##") + "%", text_color=color.white, bgcolor=dd_col, text_size=size.small)
    table.cell(stats_panel, 0, 8,  "Capital simple",                            text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 8,  "$" + str.tostring(simple_capital,"#.##"),   text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(stats_panel, 0, 9,  "Capital compuesto",                         text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 9,  "$" + str.tostring(compound_capital,"#.##"), text_color=color.white, bgcolor=color.new(color.blue, 75), text_size=size.small)
    table.cell(stats_panel, 0, 10, "Mejor método",                              text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 10, compound_capital > simple_capital ? "Compuesto" : simple_capital > compound_capital ? "Simple" : "Iguales", text_color=color.white, text_size=size.small)

// ═══════════════════════════════════════════════════════════════
// ALERTAS
// ═══════════════════════════════════════════════════════════════
alertcondition(final_any_signal, "Señal EMA Touch (cualquier combo)", "EMA Touch: señal del día disparada")
alertcondition(final_signal_1,   "Señal C1 — EMA Touch",  "Combo 1 disparó señal EMA Touch")
alertcondition(final_signal_2,   "Señal C2 — EMA Touch",  "Combo 2 disparó señal EMA Touch")
alertcondition(final_signal_3,   "Señal C3 — EMA Touch",  "Combo 3 disparó señal EMA Touch")
alertcondition(final_signal_4,   "Señal C4 — EMA Touch",  "Combo 4 disparó señal EMA Touch")
alertcondition(final_signal_5,   "Señal C5 — EMA Touch",  "Combo 5 disparó señal EMA Touch")
alertcondition(final_signal_6,   "Señal C6 — EMA Touch",  "Combo 6 disparó señal EMA Touch")
alertcondition(final_signal_7,   "Señal C7 — EMA Touch",  "Combo 7 disparó señal EMA Touch")
alertcondition(final_signal_8,   "Señal C8 — EMA Touch",  "Combo 8 disparó señal EMA Touch")
alertcondition(final_signal_9,   "Señal C9 — EMA Touch",  "Combo 9 disparó señal EMA Touch")
alertcondition(final_signal_10,  "Señal C10 — EMA Touch", "Combo 10 disparó señal EMA Touch")
alertcondition(final_signal_11,  "Señal C11 — EMA Touch", "Combo 11 disparó señal EMA Touch")
alertcondition(final_signal_12,  "Señal C12 — EMA Touch", "Combo 12 disparó señal EMA Touch")
alertcondition(final_signal_13,  "Señal C13 — EMA Touch", "Combo 13 disparó señal EMA Touch")
alertcondition(tp_hit,           "TP alcanzado — EMA Touch", "EMA Touch: Take Profit alcanzado")
alertcondition(sl_hit,           "SL alcanzado — EMA Touch", "EMA Touch: Stop Loss alcanzado")

// Alerta dinámica JSON → webhook
active_account =
     combos_active == 13 ? account_13 :
     combos_active == 12 ? account_12 :
     combos_active == 11 ? account_11 :
     combos_active == 10 ? account_10 :
     combos_active == 9  ? account_9  :
     combos_active == 8  ? account_8  :
     combos_active == 7  ? account_7  :
     combos_active == 6  ? account_6  :
     combos_active == 5  ? account_5  :
     combos_active == 4  ? account_4  :
     combos_active == 3  ? account_3  :
     combos_active == 2  ? account_2  :
                           account_1

if final_any_signal
    _tipo_str = (trade_tipo == 1) ? "R" : "S"
    _tp = final_signal_1  ? tp_pct1  : final_signal_2  ? tp_pct2  : final_signal_3  ? tp_pct3  :
          final_signal_4  ? tp_pct4  : final_signal_5  ? tp_pct5  : final_signal_6  ? tp_pct6  :
          final_signal_7  ? tp_pct7  : final_signal_8  ? tp_pct8  : final_signal_9  ? tp_pct9  :
          final_signal_10 ? tp_pct10 : final_signal_11 ? tp_pct11 : final_signal_12 ? tp_pct12 : tp_pct13
    _sl = final_signal_1  ? sl_pct1  : final_signal_2  ? sl_pct2  : final_signal_3  ? sl_pct3  :
          final_signal_4  ? sl_pct4  : final_signal_5  ? sl_pct5  : final_signal_6  ? sl_pct6  :
          final_signal_7  ? sl_pct7  : final_signal_8  ? sl_pct8  : final_signal_9  ? sl_pct9  :
          final_signal_10 ? sl_pct10 : final_signal_11 ? sl_pct11 : final_signal_12 ? sl_pct12 : sl_pct13
    alert('{"secret":"TestAndres","account":"' + active_account + '","tipo":"' + _tipo_str + '","tp":' + str.tostring(_tp) + ',"sl":' + str.tostring(_sl) + '}', alert.freq_once_per_bar_close)
