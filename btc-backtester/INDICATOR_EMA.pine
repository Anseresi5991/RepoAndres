show_trade_lines  = input.bool(true, "Mostrar líneas TP/SL",    group=grp_visual)

// ── Subcuentas ───────────────────────────────────────────────
grp_accounts = "Subcuentas por cantidad de combos"
account_13 = input.string("EMA_TOUCH_13", "Account 13 combos", group=grp_accounts)
account_12 = input.string("EMA_TOUCH_12", "Account 12 combos", group=grp_accounts)
account_11 = input.string("EMA_TOUCH_11", "Account 11 combos", group=grp_accounts)
account_10 = input.string("EMA_TOUCH_10", "Account 10 combos", group=grp_accounts)
