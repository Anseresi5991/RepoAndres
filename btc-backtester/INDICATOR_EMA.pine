// ═══════════════════════════════════════════════════════════════
// CIERRE DE TRADE — SL tiene prioridad
// TP/SL solo desde la vela siguiente a la entrada
// ═══════════════════════════════════════════════════════════════
sl_hit = trade_open and bar_index != entry_bar and
     ((trade_tipo == 1 and high >= stop_loss_price) or
      (trade_tipo == 2 and low  <= stop_loss_price))
tp_hit = trade_open and bar_index != entry_bar and not sl_hit and
     ((trade_tipo == 1 and low  <= take_profit_price) or
      (trade_tipo == 2 and high >= take_profit_price))

// ═══════════════════════════════════════════════════════════════
// ESTADÍSTICAS
// ═══════════════════════════════════════════════════════════════
var int   total_tp_count      = 0
var int   total_sl_count      = 0
var int   total_closed_trades = 0
var float total_profit_pct    = 0.0
var float total_loss_pct      = 0.0
var float total_net_pct       = 0.0
var float equity_pct          = 0.0
var float equity_peak_pct     = 0.0
var float max_drawdown_pct    = 0.0
var float compound_capital    = na

if barstate.isfirst
    compound_capital := initial_capital
    simple_capital   := initial_capital

if sl_hit
    trade_open          := false
    entry_price         := na
    stop_loss_price     := na
    take_profit_price   := na
    trade_result        := "SL ❌"
    total_sl_count      += 1
    total_closed_trades += 1
    total_loss_pct      += trade_eff_sl_pct
    total_net_pct       := total_profit_pct - total_loss_pct
    equity_pct          -= trade_eff_sl_pct
    equity_peak_pct     := math.max(equity_peak_pct, equity_pct)
    max_drawdown_pct    := math.max(max_drawdown_pct, equity_peak_pct - equity_pct)
    simple_capital      := initial_capital * (1 + total_net_pct / 100)
    compound_capital    := compound_capital * (1 - trade_eff_sl_pct / 100)

else if tp_hit
    trade_open          := false
    entry_price         := na
    stop_loss_price     := na
    take_profit_price   := na
    trade_result        := "TP ✅"
    total_tp_count      += 1
    total_closed_trades += 1
    total_profit_pct    += trade_eff_tp_pct
    total_net_pct       := total_profit_pct - total_loss_pct
    equity_pct          += trade_eff_tp_pct
    equity_peak_pct     := math.max(equity_peak_pct, equity_pct)
    max_drawdown_pct    := math.max(max_drawdown_pct, equity_peak_pct - equity_pct)
    simple_capital      := initial_capital * (1 + total_net_pct / 100)
    compound_capital    := compound_capital * (1 + trade_eff_tp_pct / 100)

win_rate = total_closed_trades > 0 ? (total_tp_count / total_closed_trades) * 100 : 0.0

// ═══════════════════════════════════════════════════════════════
// VISUALES — EMAs
// ═══════════════════════════════════════════════════════════════
plot(show_ema_lines ? ema1  : na, "EMA C1",  color=color.new(color.orange,  0), linewidth=1)
plot(show_ema_lines and use_c2  ? ema2  : na, "EMA C2",  color=color.new(color.purple,  0), linewidth=1)
plot(show_ema_lines and use_c3  ? ema3  : na, "EMA C3",  color=color.new(color.teal,    0), linewidth=1)
plot(show_ema_lines and use_c4  ? ema4  : na, "EMA C4",  color=color.new(color.blue,    0), linewidth=1)
plot(show_ema_lines and use_c5  ? ema5  : na, "EMA C5",  color=color.new(color.fuchsia, 0), linewidth=1)
plot(show_ema_lines and use_c6  ? ema6  : na, "EMA C6",  color=color.new(color.lime,    0), linewidth=1)
plot(show_ema_lines and use_c7  ? ema7  : na, "EMA C7",  color=color.new(color.yellow,  0), linewidth=1)
plot(show_ema_lines and use_c8  ? ema8  : na, "EMA C8",  color=color.new(color.aqua,    0), linewidth=1)
plot(show_ema_lines and use_c9  ? ema9  : na, "EMA C9",  color=color.new(color.maroon,  0), linewidth=1)
plot(show_ema_lines and use_c10 ? ema10 : na, "EMA C10", color=color.new(color.silver,  0), linewidth=1)
plot(show_ema_lines and use_c11 ? ema11 : na, "EMA C11", color=color.new(color.navy,    0), linewidth=1)
plot(show_ema_lines and use_c12 ? ema12 : na, "EMA C12", color=color.new(color.olive,   0), linewidth=1)
plot(show_ema_lines and use_c13 ? ema13 : na, "EMA C13", color=color.new(color.gray,    0), linewidth=1)
plot(show_ema_lines and use_slow_filter ? slow_ema_val : na, "EMA Lenta", color=color.new(color.white, 40), linewidth=2, style=plot.style_line)

// ── Señales SHORT (flecha abajo, arriba de la barra) ─────────
plotshape(show_signal_marks and op_s1,  title="SHORT C1",  style=shape.labeldown, location=location.abovebar, color=color.orange,                   textcolor=color.white, size=size.tiny, text="C1▼")
plotshape(show_signal_marks and op_s2,  title="SHORT C2",  style=shape.labeldown, location=location.abovebar, color=color.new(color.purple,  0),    textcolor=color.white, size=size.tiny, text="C2▼")
