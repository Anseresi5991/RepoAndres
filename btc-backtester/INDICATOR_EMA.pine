// ═══════════════════════════════════════════════════════════════
// SEÑALES CON PRIORIDAD C1 > C2 > … > C13 — 1 trade por día (UTC)
// ═══════════════════════════════════════════════════════════════
new_day_utc = ta.change(time("D", "0000-0000", "UTC")) != 0

var bool daily_signal_used = false
if new_day_utc
    daily_signal_used := false

var bool trade_open        = false
var float entry_price      = na
var float stop_loss_price  = na
var float take_profit_price = na
var int   entry_bar        = na
var int   trade_tipo       = 0   // 1=SHORT, 2=LONG
var string trade_result    = "Sin trade"
var float trade_eff_tp_pct = 0.0
var float trade_eff_sl_pct = 0.0

can_fire_now = not daily_signal_used and not trade_open

final_signal_1  = fires1  and can_fire_now
final_signal_2  = fires2  and can_fire_now and not final_signal_1
final_signal_3  = fires3  and can_fire_now and not final_signal_1 and not final_signal_2
final_signal_4  = fires4  and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3
final_signal_5  = fires5  and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3 and not final_signal_4
final_signal_6  = fires6  and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3 and not final_signal_4 and not final_signal_5
final_signal_7  = fires7  and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3 and not final_signal_4 and not final_signal_5 and not final_signal_6
final_signal_8  = fires8  and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3 and not final_signal_4 and not final_signal_5 and not final_signal_6 and not final_signal_7
final_signal_9  = fires9  and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3 and not final_signal_4 and not final_signal_5 and not final_signal_6 and not final_signal_7 and not final_signal_8
final_signal_10 = fires10 and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3 and not final_signal_4 and not final_signal_5 and not final_signal_6 and not final_signal_7 and not final_signal_8 and not final_signal_9
final_signal_11 = fires11 and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3 and not final_signal_4 and not final_signal_5 and not final_signal_6 and not final_signal_7 and not final_signal_8 and not final_signal_9 and not final_signal_10
final_signal_12 = fires12 and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3 and not final_signal_4 and not final_signal_5 and not final_signal_6 and not final_signal_7 and not final_signal_8 and not final_signal_9 and not final_signal_10 and not final_signal_11
final_signal_13 = fires13 and can_fire_now and not final_signal_1 and not final_signal_2 and not final_signal_3 and not final_signal_4 and not final_signal_5 and not final_signal_6 and not final_signal_7 and not final_signal_8 and not final_signal_9 and not final_signal_10 and not final_signal_11 and not final_signal_12

final_any_signal = final_signal_1 or final_signal_2 or final_signal_3 or final_signal_4 or final_signal_5 or final_signal_6 or final_signal_7 or final_signal_8 or final_signal_9 or final_signal_10 or final_signal_11 or final_signal_12 or final_signal_13

if final_any_signal
    daily_signal_used := true

// Flags de apertura para plotshape (se resetean cada barra)
var bool op_s1 = false
var bool op_l1 = false
var bool op_s2 = false
var bool op_l2 = false
var bool op_s3 = false
var bool op_l3 = false
var bool op_s4 = false
var bool op_l4 = false
var bool op_s5 = false
var bool op_l5 = false
var bool op_s6 = false
var bool op_l6 = false
var bool op_s7 = false
var bool op_l7 = false
var bool op_s8 = false
var bool op_l8 = false
var bool op_s9 = false
var bool op_l9 = false
var bool op_s10 = false
var bool op_l10 = false
var bool op_s11 = false
var bool op_l11 = false
var bool op_s12 = false
var bool op_l12 = false
var bool op_s13 = false
var bool op_l13 = false

op_s1:=false
op_l1:=false
op_s2:=false
op_l2:=false
op_s3:=false
op_l3:=false
op_s4:=false
op_l4:=false
op_s5:=false
op_l5:=false
op_s6:=false
op_l6:=false
op_s7:=false
op_l7:=false
op_s8:=false
op_l8:=false
op_s9:=false
op_l9:=false
op_s10:=false
op_l10:=false
op_s11:=false
op_l11:=false
op_s12:=false
op_l12:=false
op_s13:=false
op_l13:=false

// ═══════════════════════════════════════════════════════════════
// APERTURA DE TRADES
// ═══════════════════════════════════════════════════════════════

if final_signal_1
    _tipo = sig_s1 ? 1 : 2
    _sl   = _tipo==1 ? close*(1+sl_pct1/100) : close*(1-sl_pct1/100)
    _tp   = _tipo==1 ? close*(1-tp_pct1/100) : close*(1+tp_pct1/100)
    entry_price       := close
    stop_loss_price   := _sl
    take_profit_price := _tp
    trade_eff_tp_pct  := math.max(tp_pct1-fee_tp_pct,0)*leverage
    trade_eff_sl_pct  := (sl_pct1+fee_sl_pct)*leverage
    trade_open        := true
    trade_tipo        := _tipo
    entry_bar         := bar_index
    trade_result      := "Abierto (C1 " + (_tipo==1?"SHORT":"LONG") + ")"
    if sig_s1
        op_s1 := true
    else
        op_l1 := true

if final_signal_2
    _tipo = sig_s2 ? 1 : 2
    _sl   = _tipo==1 ? close*(1+sl_pct2/100) : close*(1-sl_pct2/100)
    _tp   = _tipo==1 ? close*(1-tp_pct2/100) : close*(1+tp_pct2/100)
    entry_price       := close
    stop_loss_price   := _sl
    take_profit_price := _tp
    trade_eff_tp_pct  := math.max(tp_pct2-fee_tp_pct,0)*leverage
    trade_eff_sl_pct  := (sl_pct2+fee_sl_pct)*leverage
    trade_open        := true
    trade_tipo        := _tipo
    entry_bar         := bar_index
    trade_result      := "Abierto (C2 " + (_tipo==1?"SHORT":"LONG") + ")"
    if sig_s2
        op_s2 := true
    else
        op_l2 := true

if final_signal_3
    _tipo = sig_s3 ? 1 : 2
    _sl   = _tipo==1 ? close*(1+sl_pct3/100) : close*(1-sl_pct3/100)
    _tp   = _tipo==1 ? close*(1-tp_pct3/100) : close*(1+tp_pct3/100)
    entry_price       := close
    stop_loss_price   := _sl
    take_profit_price := _tp
    trade_eff_tp_pct  := math.max(tp_pct3-fee_tp_pct,0)*leverage
    trade_eff_sl_pct  := (sl_pct3+fee_sl_pct)*leverage
