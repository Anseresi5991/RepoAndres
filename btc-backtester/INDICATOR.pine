//@version=5
indicator("12 Combos BTC Rango Dinámico + Solo Resistencias", overlay=true)

// --- 1. CONFIGURACIÓN DEL RANGO — COMBO 1 (principal) ---
grp_params = "Combo 1 — Configuración del Rango"
min_range_pct    = input.float(0.6,  "Tamaño Mínimo (%)", minval=0.1, step=0.1, tooltip="% mínimo de compresión del rango", group=grp_params)
max_range_pct    = input.float(1.2,  "Tamaño Máximo (%)", minval=0.1, step=0.1, tooltip="% máximo de compresión del rango", group=grp_params)
lookback_candles = input.int(20,     "Velas hacia atrás",  minval=1,   tooltip="Cuántas velas analizamos para definir el rango", group=grp_params)
min_wick_pct     = input.float(15.0, "Mecha mínima (%)",  minval=0.1, step=0.1, tooltip="% mínimo de mecha superior respecto al rango de la vela", group=grp_params)
sl_pct           = input.float(0.5,  "SL (%)",  minval=0.01, step=0.01, group=grp_params)
tp_pct           = input.float(0.15, "TP (%)",  minval=0.01, step=0.01, group=grp_params)

var float simple_capital = na

// --- 2. COMBO 2 (opcional) ---
grp_c2       = "Combo 2 (opcional)"
use_combo2   = input.bool(false, "Activar Combo 2", group=grp_c2)
min_range2   = input.float(0.6,  "Mínimo (%)",      minval=0.1, step=0.1,  group=grp_c2)
max_range2   = input.float(1.2,  "Máximo (%)",      minval=0.1, step=0.1,  group=grp_c2)
lookback2    = input.int(20,     "Velas lookback",  minval=1,               group=grp_c2)
min_wick2    = input.float(15.0, "Mecha mínima (%)",minval=0.1, step=0.1,  group=grp_c2)
sl_pct2      = input.float(0.5,  "SL (%)",          minval=0.01, step=0.01, group=grp_c2)
tp_pct2      = input.float(0.15, "TP (%)",          minval=0.01, step=0.01, group=grp_c2)

