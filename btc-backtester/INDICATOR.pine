use_combo6   = input.bool(false, "Activar Combo 6", group=grp_c6)
min_range6   = input.float(0.6,  "Mínimo (%)",      minval=0.1, step=0.1,  group=grp_c6)
max_range6   = input.float(1.2,  "Máximo (%)",      minval=0.1, step=0.1,  group=grp_c6)
