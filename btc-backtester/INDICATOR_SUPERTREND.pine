plot(show_st and uc11 ? st11 : na, "ST C11", color=d11 < 0 ? color.navy                    : color.new(color.navy,    60), linewidth=1, style=plot.style_linebr)
plot(show_st and uc12 ? st12 : na, "ST C12", color=d12 < 0 ? color.olive                   : color.new(color.olive,   60), linewidth=1, style=plot.style_linebr)
