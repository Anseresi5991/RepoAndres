// ═══════════════════════════════════════════════════════════════════════════
// ESTADO DEL TRADE (1 trade a la vez — primer combo que dispara gana)
// ═══════════════════════════════════════════════════════════════════════════
var float entry_price = na
var float tp_price    = na
var float sl_price    = na
var bool  trade_open  = false
var bool  is_long     = false
var int   entry_bar   = -1
var float eff_tp      = 0.0
var float eff_sl      = 0.0
var string trd_result = "Sin trade"

var bool op1  = false
var bool op2  = false
var bool op3  = false
var bool op4  = false
var bool op5  = false
var bool op6  = false
var bool op7  = false
var bool op8  = false
var bool op9  = false
var bool op10 = false
var bool op11 = false
var bool op12 = false
var bool op13 = false
var bool op14 = false
var bool op15 = false

op1  := false
op2  := false
op3  := false
op4  := false
op5  := false
op6  := false
op7  := false
op8  := false
op9  := false
op10 := false
op11 := false
op12 := false
op13 := false
op14 := false
op15 := false

var int   tot_tp  = 0
var int   tot_sl  = 0
var int   tot_cl  = 0
var float prof    = 0.0
var float loss    = 0.0
var float net     = 0.0
var float eq      = 0.0
var float eq_pk   = 0.0
var float max_dd  = 0.0
var float cmp_cap = na
var float smp_cap = na

if barstate.isfirst
    cmp_cap := cap0
    smp_cap := cap0

// ─── Evaluar TP/SL (no en la vela de apertura) ───────────────────────────
tp_hit = trade_open and bar_index != entry_bar and (is_long ? high >= tp_price : low  <= tp_price)
sl_hit = trade_open and bar_index != entry_bar and not tp_hit and (is_long ? low <= sl_price : high >= sl_price)

if tp_hit
    trade_open  := false
    entry_price := na
    tp_price    := na
    sl_price    := na
    trd_result  := "TP ✅"
    tot_tp      += 1
    tot_cl      += 1
    prof        += eff_tp
    net         := prof - loss
    eq          += eff_tp
    eq_pk       := math.max(eq_pk, eq)
    max_dd      := math.max(max_dd, eq_pk - eq)
    smp_cap     := cap0 * (1 + net / 100)
    cmp_cap     := cmp_cap * (1 + eff_tp / 100)

else if sl_hit
    trade_open  := false
    entry_price := na
    tp_price    := na
    sl_price    := na
    trd_result  := "SL ❌"
    tot_sl      += 1
    tot_cl      += 1
    loss        += eff_sl
    net         := prof - loss
    eq          -= eff_sl
    eq_pk       := math.max(eq_pk, eq)
    max_dd      := math.max(max_dd, eq_pk - eq)
    smp_cap     := cap0 * (1 + net / 100)
    cmp_cap     := cmp_cap * (1 - eff_sl / 100)

// ─── Abrir trade — primer combo en orden de prioridad ────────────────────
if not trade_open
    if ls1 or ss1
        is_long     := ls1
        entry_price := close
        tp_price    := ls1 ? close * (1 + tp1 / 100) : close * (1 - tp1 / 100)
        sl_price    := ls1 ? close * (1 - sl1 / 100) : close * (1 + sl1 / 100)
        eff_tp      := math.max(tp1 - fee_tp, 0) * lev
        eff_sl      := (sl1 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls1 ? "LONG (C1)" : "SHORT (C1)"
        op1         := true
    else if ls2 or ss2
        is_long     := ls2
        entry_price := close
        tp_price    := ls2 ? close * (1 + tp2 / 100) : close * (1 - tp2 / 100)
        sl_price    := ls2 ? close * (1 - sl2 / 100) : close * (1 + sl2 / 100)
        eff_tp      := math.max(tp2 - fee_tp, 0) * lev
        eff_sl      := (sl2 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls2 ? "LONG (C2)" : "SHORT (C2)"
        op2         := true
    else if ls3 or ss3
        is_long     := ls3
        entry_price := close
        tp_price    := ls3 ? close * (1 + tp3 / 100) : close * (1 - tp3 / 100)
        sl_price    := ls3 ? close * (1 - sl3 / 100) : close * (1 + sl3 / 100)
        eff_tp      := math.max(tp3 - fee_tp, 0) * lev
        eff_sl      := (sl3 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls3 ? "LONG (C3)" : "SHORT (C3)"
        op3         := true
    else if ls4 or ss4
        is_long     := ls4
        entry_price := close
        tp_price    := ls4 ? close * (1 + tp4 / 100) : close * (1 - tp4 / 100)
        sl_price    := ls4 ? close * (1 - sl4 / 100) : close * (1 + sl4 / 100)
        eff_tp      := math.max(tp4 - fee_tp, 0) * lev
        eff_sl      := (sl4 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls4 ? "LONG (C4)" : "SHORT (C4)"
        op4         := true
    else if ls5 or ss5
        is_long     := ls5
        entry_price := close
        tp_price    := ls5 ? close * (1 + tp5 / 100) : close * (1 - tp5 / 100)
        sl_price    := ls5 ? close * (1 - sl5 / 100) : close * (1 + sl5 / 100)
        eff_tp      := math.max(tp5 - fee_tp, 0) * lev
        eff_sl      := (sl5 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls5 ? "LONG (C5)" : "SHORT (C5)"
        op5         := true
    else if ls6 or ss6
        is_long     := ls6
        entry_price := close
        tp_price    := ls6 ? close * (1 + tp6 / 100) : close * (1 - tp6 / 100)
        sl_price    := ls6 ? close * (1 - sl6 / 100) : close * (1 + sl6 / 100)
        eff_tp      := math.max(tp6 - fee_tp, 0) * lev
        eff_sl      := (sl6 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls6 ? "LONG (C6)" : "SHORT (C6)"
        op6         := true
    else if ls7 or ss7
        is_long     := ls7
        entry_price := close
        tp_price    := ls7 ? close * (1 + tp7 / 100) : close * (1 - tp7 / 100)
        sl_price    := ls7 ? close * (1 - sl7 / 100) : close * (1 + sl7 / 100)
        eff_tp      := math.max(tp7 - fee_tp, 0) * lev
        eff_sl      := (sl7 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls7 ? "LONG (C7)" : "SHORT (C7)"
        op7         := true
    else if ls8 or ss8
        is_long     := ls8
        entry_price := close
        tp_price    := ls8 ? close * (1 + tp8 / 100) : close * (1 - tp8 / 100)
        sl_price    := ls8 ? close * (1 - sl8 / 100) : close * (1 + sl8 / 100)
        eff_tp      := math.max(tp8 - fee_tp, 0) * lev
        eff_sl      := (sl8 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls8 ? "LONG (C8)" : "SHORT (C8)"
        op8         := true
    else if ls9 or ss9
        is_long     := ls9
        entry_price := close
        tp_price    := ls9 ? close * (1 + tp9 / 100) : close * (1 - tp9 / 100)
        sl_price    := ls9 ? close * (1 - sl9 / 100) : close * (1 + sl9 / 100)
        eff_tp      := math.max(tp9 - fee_tp, 0) * lev
        eff_sl      := (sl9 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls9 ? "LONG (C9)" : "SHORT (C9)"
        op9         := true
    else if ls10 or ss10
        is_long     := ls10
        entry_price := close
        tp_price    := ls10 ? close * (1 + tp10 / 100) : close * (1 - tp10 / 100)
        sl_price    := ls10 ? close * (1 - sl10 / 100) : close * (1 + sl10 / 100)
        eff_tp      := math.max(tp10 - fee_tp, 0) * lev
        eff_sl      := (sl10 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls10 ? "LONG (C10)" : "SHORT (C10)"
        op10        := true
    else if ls11 or ss11
        is_long     := ls11
        entry_price := close
        tp_price    := ls11 ? close * (1 + tp11 / 100) : close * (1 - tp11 / 100)
        sl_price    := ls11 ? close * (1 - sl11 / 100) : close * (1 + sl11 / 100)
        eff_tp      := math.max(tp11 - fee_tp, 0) * lev
        eff_sl      := (sl11 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls11 ? "LONG (C11)" : "SHORT (C11)"
        op11        := true
    else if ls12 or ss12
        is_long     := ls12
        entry_price := close
        tp_price    := ls12 ? close * (1 + tp12 / 100) : close * (1 - tp12 / 100)
        sl_price    := ls12 ? close * (1 - sl12 / 100) : close * (1 + sl12 / 100)
        eff_tp      := math.max(tp12 - fee_tp, 0) * lev
        eff_sl      := (sl12 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls12 ? "LONG (C12)" : "SHORT (C12)"
        op12        := true
    else if ls13 or ss13
        is_long     := ls13
        entry_price := close
        tp_price    := ls13 ? close * (1 + tp13 / 100) : close * (1 - tp13 / 100)
        sl_price    := ls13 ? close * (1 - sl13 / 100) : close * (1 + sl13 / 100)
        eff_tp      := math.max(tp13 - fee_tp, 0) * lev
        eff_sl      := (sl13 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls13 ? "LONG (C13)" : "SHORT (C13)"
        op13        := true
    else if ls14 or ss14
        is_long     := ls14
        entry_price := close
        tp_price    := ls14 ? close * (1 + tp14 / 100) : close * (1 - tp14 / 100)
        sl_price    := ls14 ? close * (1 - sl14 / 100) : close * (1 + sl14 / 100)
        eff_tp      := math.max(tp14 - fee_tp, 0) * lev
        eff_sl      := (sl14 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls14 ? "LONG (C14)" : "SHORT (C14)"
        op14        := true
    else if ls15 or ss15
        is_long     := ls15
        entry_price := close
        tp_price    := ls15 ? close * (1 + tp15 / 100) : close * (1 - tp15 / 100)
        sl_price    := ls15 ? close * (1 - sl15 / 100) : close * (1 + sl15 / 100)
        eff_tp      := math.max(tp15 - fee_tp, 0) * lev
        eff_sl      := (sl15 + fee_sl) * lev
        trade_open  := true
        entry_bar   := bar_index
        trd_result  := ls15 ? "LONG (C15)" : "SHORT (C15)"
        op15        := true

any_signal = op1 or op2 or op3 or op4 or op5 or op6 or op7 or op8 or op9 or op10 or op11 or op12 or op13 or op14 or op15
win_rate   = tot_cl > 0 ? (tot_tp / tot_cl) * 100 : 0.0

// ═══════════════════════════════════════════════════════════════════════════
// VISUALES — líneas Supertrend
// ═══════════════════════════════════════════════════════════════════════════
plot(show_st and uc1  ? st1  : na, "ST C1",  color=d1  < 0 ? color.orange                  : color.new(color.orange,  60), linewidth=1, style=plot.style_linebr)
plot(show_st and uc2  ? st2  : na, "ST C2",  color=d2  < 0 ? color.purple                  : color.new(color.purple,  60), linewidth=1, style=plot.style_linebr)
plot(show_st and uc3  ? st3  : na, "ST C3",  color=d3  < 0 ? color.teal                    : color.new(color.teal,    60), linewidth=1, style=plot.style_linebr)
plot(show_st and uc4  ? st4  : na, "ST C4",  color=d4  < 0 ? color.blue                    : color.new(color.blue,    60), linewidth=1, style=plot.style_linebr)
