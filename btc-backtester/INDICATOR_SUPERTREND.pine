//@version=5
indicator("15 Combos Supertrend Multi-Estrategia", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// PARÁMETROS GLOBALES
// ═══════════════════════════════════════════════════════════════════════════
grp_g = "Configuración Global"
trade_dir = input.string("Ambas", "Dirección de trades", options=["Ambas","Solo Long","Solo Short"], group=grp_g)
skip_sun  = input.bool(true,  "Omitir domingos (UTC)", group=grp_g)
atr_vp    = input.int(20,    "SMA ATR vol (barras)",   minval=1, group=grp_g)
rsi_p     = input.int(14,    "Período RSI",             minval=1, group=grp_g)

grp_st = "Estadísticas"
fee_sl = input.float(0.10,   "Fee extra SL (%)",           minval=0.0, step=0.01, group=grp_st)
fee_tp = input.float(0.05,   "Fee descontado TP (%)",      minval=0.0, step=0.01, group=grp_st)
lev    = input.float(10.0,   "Apalancamiento",              minval=1.0, step=1.0,  group=grp_st)
cap0   = input.float(1000.0, "Capital inicial (compuesto)", minval=1.0, step=100.0, group=grp_st)

grp_vis = "Apariencia"
show_st  = input.bool(true, "Mostrar líneas Supertrend",    group=grp_vis)
show_sig = input.bool(true, "Mostrar marcas de señal",      group=grp_vis)
show_trd = input.bool(true, "Mostrar líneas Entrada/TP/SL", group=grp_vis)

// ═══════════════════════════════════════════════════════════════════════════
// COMBO 1  P8 M6.0 V1.5 R0 B1.0 TP2.45 SL2.60
// ═══════════════════════════════════════════════════════════════════════════
grp1 = "Combo 1  P8 M6.0 V1.5 R0 B1.0"
uc1  = input.bool(true,  "Act C1",   group=grp1)
p1   = input.int(8,      "ATR Per",  group=grp1, minval=1)
m1   = input.float(6.0,  "ATR Mult", group=grp1, minval=0.1, step=0.5)
vf1  = input.float(1.5,  "ATR VolF", group=grp1, minval=0.0, step=0.1)
rt1  = input.float(0.0,  "RSI Thr",  group=grp1, minval=0.0, step=5.0)
bm1  = input.float(1.0,  "Body Min", group=grp1, minval=0.0, step=0.1)
tp1  = input.float(2.45, "TP %",     group=grp1, minval=0.01, step=0.05)
sl1  = input.float(2.6,  "SL %",     group=grp1, minval=0.01, step=0.05)

