vf2  = input.float(2.0,  "ATR VolF", group=grp2, minval=0.0, step=0.1)
rt2  = input.float(0.0,  "RSI Thr",  group=grp2, minval=0.0, step=5.0)
bm2  = input.float(1.0,  "Body Min", group=grp2, minval=0.0, step=0.1)
tp2  = input.float(1.25, "TP %",     group=grp2, minval=0.01, step=0.05)
sl2  = input.float(2.9,  "SL %",     group=grp2, minval=0.01, step=0.05)

