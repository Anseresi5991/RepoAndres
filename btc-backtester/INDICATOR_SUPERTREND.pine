p14   = input.int(11,     "ATR Per",  group=grp14, minval=1)
m14   = input.float(7.5,  "ATR Mult", group=grp14, minval=0.1, step=0.5)
vf14  = input.float(1.0,  "ATR VolF", group=grp14, minval=0.0, step=0.1)
rt14  = input.float(70.0, "RSI Thr",  group=grp14, minval=0.0, step=5.0)
