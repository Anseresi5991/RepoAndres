sl14  = input.float(2.4,  "SL %",     group=grp14, minval=0.01, step=0.05)

// ═══════════════════════════════════════════════════════════════════════════
// COMBO 15  P5 M7.0 V1.0 R65 B0.8 TP1.35 SL2.80
// ═══════════════════════════════════════════════════════════════════════════
grp15 = "Combo 15  P5 M7.0 V1.0 R65 B0.8"
uc15  = input.bool(true,  "Act C15",  group=grp15)
p15   = input.int(5,      "ATR Per",  group=grp15, minval=1)
m15   = input.float(7.0,  "ATR Mult", group=grp15, minval=0.1, step=0.5)
vf15  = input.float(1.0,  "ATR VolF", group=grp15, minval=0.0, step=0.1)
rt15  = input.float(65.0, "RSI Thr",  group=grp15, minval=0.0, step=5.0)
bm15  = input.float(0.8,  "Body Min", group=grp15, minval=0.0, step=0.1)
tp15  = input.float(1.35, "TP %",     group=grp15, minval=0.01, step=0.05)
sl15  = input.float(2.8,  "SL %",     group=grp15, minval=0.01, step=0.05)

// Webhook
grp_wh  = "Webhook"
wh_acct = input.string("SUPERTREND_15", "Account ID", group=grp_wh)

// ═══════════════════════════════════════════════════════════════════════════
// CÁLCULOS COMPARTIDOS
// ═══════════════════════════════════════════════════════════════════════════
rsi      = ta.rsi(close, rsi_p)
body_r   = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0.0
is_sun   = dayofweek == dayofweek.sunday
can_long = trade_dir != "Solo Short"
can_sht  = trade_dir != "Solo Long"

// ═══════════════════════════════════════════════════════════════════════════
// SUPERTREND POR COMBO
// Pine: direction = -1 cuando alcista (bullish), direction = 1 cuando bajista
// LONG cross  : direction pasa de  1 → -1
// SHORT cross : direction pasa de -1 →  1
// ═══════════════════════════════════════════════════════════════════════════
[st1,  d1]  = ta.supertrend(m1,  p1)
[st2,  d2]  = ta.supertrend(m2,  p2)
[st3,  d3]  = ta.supertrend(m3,  p3)
[st4,  d4]  = ta.supertrend(m4,  p4)
[st5,  d5]  = ta.supertrend(m5,  p5)
[st6,  d6]  = ta.supertrend(m6,  p6)
[st7,  d7]  = ta.supertrend(m7,  p7)
[st8,  d8]  = ta.supertrend(m8,  p8)
[st9,  d9]  = ta.supertrend(m9,  p9)
[st10, d10] = ta.supertrend(m10, p10)
[st11, d11] = ta.supertrend(m11, p11)
[st12, d12] = ta.supertrend(m12, p12)
[st13, d13] = ta.supertrend(m13, p13)
[st14, d14] = ta.supertrend(m14, p14)
[st15, d15] = ta.supertrend(m15, p15)

// ATR raw para vol filter
a1   = ta.atr(p1)
ab1  = ta.sma(a1,  atr_vp)
a2   = ta.atr(p2)
ab2  = ta.sma(a2,  atr_vp)
a3   = ta.atr(p3)
ab3  = ta.sma(a3,  atr_vp)
a4   = ta.atr(p4)
ab4  = ta.sma(a4,  atr_vp)
a5   = ta.atr(p5)
ab5  = ta.sma(a5,  atr_vp)
a6   = ta.atr(p6)
ab6  = ta.sma(a6,  atr_vp)
a7   = ta.atr(p7)
ab7  = ta.sma(a7,  atr_vp)
a8   = ta.atr(p8)
ab8  = ta.sma(a8,  atr_vp)
a9   = ta.atr(p9)
ab9  = ta.sma(a9,  atr_vp)
a10  = ta.atr(p10)
ab10 = ta.sma(a10, atr_vp)
a11  = ta.atr(p11)
ab11 = ta.sma(a11, atr_vp)
a12  = ta.atr(p12)
ab12 = ta.sma(a12, atr_vp)
a13  = ta.atr(p13)
ab13 = ta.sma(a13, atr_vp)
a14  = ta.atr(p14)
ab14 = ta.sma(a14, atr_vp)
a15  = ta.atr(p15)
ab15 = ta.sma(a15, atr_vp)

// ═══════════════════════════════════════════════════════════════════════════
// SEÑALES POR COMBO (ls = long signal, ss = short signal)
// ═══════════════════════════════════════════════════════════════════════════
ls1  = uc1  and d1  == -1 and d1[1]  == 1  and (vf1  == 0 or (not na(ab1)  and a1  <= vf1  * ab1))  and (rt1  == 0 or (not na(rsi) and rsi <= rt1))          and (bm1  == 0 or body_r >= bm1)  and can_long and (not skip_sun or not is_sun)
ss1  = uc1  and d1  ==  1 and d1[1]  == -1 and (vf1  == 0 or (not na(ab1)  and a1  <= vf1  * ab1))  and (rt1  == 0 or (not na(rsi) and rsi >= (100 - rt1)))  and (bm1  == 0 or body_r >= bm1)  and can_sht  and (not skip_sun or not is_sun)
ls2  = uc2  and d2  == -1 and d2[1]  == 1  and (vf2  == 0 or (not na(ab2)  and a2  <= vf2  * ab2))  and (rt2  == 0 or (not na(rsi) and rsi <= rt2))          and (bm2  == 0 or body_r >= bm2)  and can_long and (not skip_sun or not is_sun)
