vf11  = input.float(0.0,  "ATR VolF", group=grp11, minval=0.0, step=0.1)
rt11  = input.float(50.0, "RSI Thr",  group=grp11, minval=0.0, step=5.0)
bm11  = input.float(0.8,  "Body Min", group=grp11, minval=0.0, step=0.1)
