plot(show_st and uc15 ? st15 : na, "ST C15", color=d15 < 0 ? color.new(color.white, 20)    : color.new(color.white,   70), linewidth=1, style=plot.style_linebr)

plot(show_trd and not na(entry_price) ? entry_price : na, "Entrada",     color=color.yellow, linewidth=2, style=plot.style_linebr)
plot(show_trd and not na(tp_price)    ? tp_price    : na, "Take Profit", color=color.lime,   linewidth=2, style=plot.style_linebr)
plot(show_trd and not na(sl_price)    ? sl_price    : na, "Stop Loss",   color=color.red,    linewidth=2, style=plot.style_linebr)

// Marcas de señal — label.new() acepta series string; plotshape solo acepta const string
if show_sig and any_signal
    _lbl = op1 ? "C1" : op2 ? "C2" : op3 ? "C3" : op4 ? "C4" : op5 ? "C5" : op6 ? "C6" : op7 ? "C7" : op8 ? "C8" : op9 ? "C9" : op10 ? "C10" : op11 ? "C11" : op12 ? "C12" : op13 ? "C13" : op14 ? "C14" : "C15"
    if is_long
        label.new(bar_index, low,  _lbl, style=label.style_label_up,   color=color.new(color.green, 0), textcolor=color.white, size=size.small)
    else
        label.new(bar_index, high, _lbl, style=label.style_label_down, color=color.new(color.red,   0), textcolor=color.white, size=size.small)

plotshape(tp_hit, "TP", style=shape.labelup,   location=location.belowbar, color=color.lime, textcolor=color.black, size=size.tiny, text="TP")
plotshape(sl_hit, "SL", style=shape.labeldown, location=location.abovebar, color=color.red,  textcolor=color.white, size=size.tiny, text="SL")

// ═══════════════════════════════════════════════════════════════════════════
// TABLAS
// ═══════════════════════════════════════════════════════════════════════════
var table info_panel  = table.new(position.bottom_right, 2, 8,  bgcolor=color.new(color.black, 60))
var table stats_panel = table.new(position.top_center,   2, 10, bgcolor=color.new(color.black, 60))

if barstate.islast
    net_col  = net >= 0 ? color.green : color.red
    dd_col   = max_dd > 0 ? color.orange : color.gray
    side_txt = is_long ? "LONG 🟢" : "SHORT 🔴"
    side_col = is_long ? color.green : color.red

    table.cell(info_panel, 0, 0, "Estado trade",    text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 0, trade_open ? side_txt : "Sin trade", text_color=color.white, bgcolor=trade_open ? side_col : color.gray, text_size=size.small)

    table.cell(info_panel, 0, 1, "Último resultado", text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 1, trd_result,          text_color=color.white, text_size=size.small)

    table.cell(info_panel, 0, 2, "Entrada",           text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 2, na(entry_price) ? "-" : str.tostring(entry_price, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(info_panel, 0, 3, "TP / SL",           text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 3, (na(tp_price) or na(sl_price)) ? "-" : str.tostring(tp_price, "#.##") + " / " + str.tostring(sl_price, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(info_panel, 0, 4, "RSI actual",        text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 4, not na(rsi) ? str.tostring(rsi, "#.##") : "-", text_color=color.white, text_size=size.small)

    table.cell(info_panel, 0, 5, "Body ratio",        text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 5, str.tostring(body_r, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(info_panel, 0, 6, "Combos activos",    text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 6, str.tostring((uc1?1:0)+(uc2?1:0)+(uc3?1:0)+(uc4?1:0)+(uc5?1:0)+(uc6?1:0)+(uc7?1:0)+(uc8?1:0)+(uc9?1:0)+(uc10?1:0)+(uc11?1:0)+(uc12?1:0)+(uc13?1:0)+(uc14?1:0)+(uc15?1:0)), text_color=color.white, text_size=size.small)

    table.cell(info_panel, 0, 7, "Dirección",         text_color=color.white, text_size=size.small)
    table.cell(info_panel, 1, 7, trade_dir,            text_color=color.white, text_size=size.small)

    table.cell(stats_panel, 0, 0, "TP cerrados",       text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 0, str.tostring(tot_tp), text_color=color.white, bgcolor=color.new(color.green, 60), text_size=size.small)

    table.cell(stats_panel, 0, 1, "SL cerrados",       text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 1, str.tostring(tot_sl), text_color=color.white, bgcolor=color.new(color.red, 60), text_size=size.small)

    table.cell(stats_panel, 0, 2, "Trades cerrados",   text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 2, str.tostring(tot_cl), text_color=color.white, text_size=size.small)

    table.cell(stats_panel, 0, 3, "Ganancia acum. x" + str.tostring(lev, "#"), text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 3, str.tostring(prof, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.green, 70), text_size=size.small)

    table.cell(stats_panel, 0, 4, "Pérdida acum. x" + str.tostring(lev, "#"), text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 4, str.tostring(loss, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.red, 70), text_size=size.small)

    table.cell(stats_panel, 0, 5, "Neto simple x" + str.tostring(lev, "#"), text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 5, str.tostring(net, "#.##") + "%", text_color=color.white, bgcolor=net_col, text_size=size.small)

    table.cell(stats_panel, 0, 6, "Win Rate",          text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 6, str.tostring(win_rate, "#.##") + "%", text_color=color.white, text_size=size.small)

    table.cell(stats_panel, 0, 7, "Máx. caída",        text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 7, str.tostring(max_dd, "#.##") + "%", text_color=color.white, bgcolor=dd_col, text_size=size.small)

    table.cell(stats_panel, 0, 8, "Capital simple",    text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 8, "$" + str.tostring(smp_cap, "#.##"), text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)

    table.cell(stats_panel, 0, 9, "Capital compuesto", text_color=color.white, text_size=size.small)
    table.cell(stats_panel, 1, 9, "$" + str.tostring(cmp_cap, "#.##"), text_color=color.white, bgcolor=color.new(color.blue, 75), text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// ALERTAS
// ═══════════════════════════════════════════════════════════════════════════
alertcondition(any_signal, "Señal Supertrend (cualquier combo)", "Supertrend: señal disparada")
alertcondition(tp_hit,     "TP alcanzado",                       "Supertrend: Take Profit alcanzado")
alertcondition(sl_hit,     "SL alcanzado",                       "Supertrend: Stop Loss alcanzado")

if any_signal
    _tp  = op1 ? tp1 : op2 ? tp2 : op3 ? tp3 : op4 ? tp4 : op5 ? tp5 : op6 ? tp6 : op7 ? tp7 : op8 ? tp8 : op9 ? tp9 : op10 ? tp10 : op11 ? tp11 : op12 ? tp12 : op13 ? tp13 : op14 ? tp14 : tp15
    _sl  = op1 ? sl1 : op2 ? sl2 : op3 ? sl3 : op4 ? sl4 : op5 ? sl5 : op6 ? sl6 : op7 ? sl7 : op8 ? sl8 : op9 ? sl9 : op10 ? sl10 : op11 ? sl11 : op12 ? sl12 : op13 ? sl13 : op14 ? sl14 : sl15
    alert('{"secret":"TestAndres","account":"' + wh_acct + '","tipo":"' + (is_long ? "S" : "R") + '","tp":' + str.tostring(_tp) + ',"sl":' + str.tostring(_sl) + '}', alert.freq_once_per_bar_close)
